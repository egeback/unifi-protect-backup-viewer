# Copy to .env and fill in. Never commit the real .env.

# UniFi Protect Integration API (reuses the same key as the UniFi Network API).
PROTECT_HOST=10.0.6.2
PROTECT_API_KEY=

# Login. Generate the hash with: ./hashpw '<plaintext password>' (or `go run ./cmd/hashpw '<password>'`)
AUTH_USER=
AUTH_PASSWORD_HASH=

# Any random long string — signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
