# Copy to app.env and fill in. Never commit the real app.env.

# UniFi Protect Integration API. PROTECT_HOST is the IP or hostname of the
# UniFi OS console running Protect (the same one you'd open the Protect web
# UI on). PROTECT_API_KEY can be the same key you use for the UniFi Network
# API, generated in the console's Settings -> Control Plane -> Integrations.
PROTECT_HOST=192.168.1.1
PROTECT_API_KEY=

# Optional: a LOCAL UniFi OS admin account (not SSO/cloud — that needs MFA
# and can't be automated), NOT the API key above. Without this, event
# classification only ever works going forward from whenever the app
# started (the Integration API's live event WebSocket) — clips from before
# that, or from any downtime, stay on the heuristic guess forever. With it,
# a periodic backfill job uses Protect's own (undocumented, session-auth)
# events API to fill those in and upgrade anything the live listener missed.
# "View Only" permissions should be enough; "Full Control" definitely works.
PROTECT_USER=
PROTECT_PASSWORD=

# Login — one entry per person, "user:hash;user2:hash2". Every user has
# equal, full access; there's no per-user permissions. Generate each hash
# with: go run ./cmd/hashpw '<plaintext password>'
#
# IMPORTANT: Compose interpolates $VAR references inside env_file values, so
# every literal $ in a bcrypt hash must be doubled to $$ here or it'll be
# silently swallowed as an "undefined variable" — corrupting the hash and
# breaking login. E.g. hashpw's `$2a$10$abc...` becomes `$$2a$$10$$abc...`
# below. One way to get it right: go run ./cmd/hashpw '<password>' | sed 's/\$/\$\$/g'
AUTH_USERS=marky:$$2a$$10$$abc...;maria:$$2a$$10$$def...

# Any random long string — signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
